# Schedule Maxing configuration -- a TEMPLATE with placeholders only.
# Keep real values out of version control (.env is git-ignored) and in your
# host's secret settings. Nothing prints these values.
#
# - The hosted backend (uvicorn) reads them from the process environment only.
# - The optional direct desktop mode (docs/direct-postgres.md) and
#   `python -m backend.migrate --env-file .env ...` read DATABASE_URL from an
#   env file only when it is named explicitly; the environment still wins.
#   Direct mode needs no JWT_SECRET. It is for private development only: the
#   database credentials give full access to every account's data.
# - The offline desktop app needs none of these.

# PostgreSQL connection URL. "postgres://" and "postgresql://" are accepted
# (the psycopg 3 driver is used). A remote server must use TLS: sslmode=require
# (used automatically when sslmode is absent in direct mode / --env-file),
# verify-ca or verify-full; disable/allow/prefer are refused there.
# For Render Postgres from your computer use the full EXTERNAL URL (hostname, never an IP);
# check it with: python -m app.persistence.verify_render --env-file .env --check-only
# (docs/render-direct-desktop.md).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# HMAC key for access tokens: at least 32 random characters, for example
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional (defaults shown).
# JWT_ISSUER=schedule-maxing
# JWT_AUDIENCE=schedule-maxing-api
# ACCESS_TOKEN_TTL_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30      # absolute native session lifetime; refresh rotates without extending it
# ENVIRONMENT=development          # production requires PostgreSQL, explicit hosts and secure cookies
# ALLOWED_HOSTS=localhost,127.0.0.1 # production: your API's public hostname
# CORS_ORIGINS=                    # exact frontend origins, no wildcards or paths
# RATE_LIMIT_ENABLED=true

# Email verification and transactional email (docs/email.md). Without these, registration answers 503.
# APP_PUBLIC_URL=https://api.example.com   # links in emails are built from this, never from a request
# SMTP_SENDER=Schedule Maxing <no-reply@mail.example.com>
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=     # EMAIL_PROVIDER=smtp (default)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_PROVIDER=brevo             # HTTPS, a single verified sender address, no domain needed
# BREVO_API_KEY=
# EMAIL_PROVIDER=mailjet           # HTTPS, a single validated sender address, no domain needed
# MAILJET_API_KEY=   MAILJET_SECRET_KEY=
# EMAIL_WEBHOOK_SECRET=            # whsec_... ; enables POST /webhooks/email (delivery and bounce evidence)
# EMAIL_DIAGNOSTIC_RECIPIENT=      # the only address `python -m backend.email_diagnostic send` mails
# VERIFICATION_TOKEN_TTL_MINUTES=1440
# PENDING_REGISTRATION_TTL_HOURS=48
# EMAIL_DNS_CHECK=false
# Account security (docs/account-security.md).
# MFA_ENCRYPTION_KEY=              # a Fernet key, used only to encrypt TOTP secrets; back it up
# PASSWORD_BREACH_CHECK=true       # k-anonymity lookup of new passwords (5 hex digits of a SHA-1 leave the server)
# REQUIRE_VERIFIED_EMAIL=false     # true: accounts whose address was never verified cannot reach records
# TRUSTED_PROXIES=                 # the reverse proxy's verified address range; empty = forwarding headers ignored
# CLIENT_IP_HEADER=                # e.g. CF-Connecting-IP, only if the trusted proxy overwrites it (docs/render-deployment.md)
# PASSWORD_HASH_CONCURRENCY=2      # per worker; each hash holds 64 MiB
# PASSWORD_HASH_QUEUE=8
# PASSWORD_HASH_WAIT_SECONDS=5
# WEB_CONCURRENCY=1                # the real number of worker processes
# PASSWORD_HASH_MEMORY_BUDGET_MB=  # startup fails if workers x concurrency x 64 MiB exceeds it
# API_MAX_PAGE_SIZE=500
# BROWSER_SESSION_TTL_MINUTES=720
# BROWSER_COOKIE_SECURE=true      # false only for plain-http local development
# ALLOWED_ORIGINS=                 # e.g. http://localhost:5173 for a separate dev frontend

# Tests only: a DISPOSABLE PostgreSQL database whose name contains "test".
# TEST_DATABASE_URL=postgresql://USER@localhost:5432/schedule_maxing_test

# See docs/backend-m8.md for local setup and rotating native-client credentials.
# Use ACCESS_TOKEN_TTL_MINUTES=15 for new production deployments.
# Native clients receive API credentials only; never distribute DATABASE_URL.
