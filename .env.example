# Schedule Maxing backend configuration -- a TEMPLATE with placeholders only.
# The backend reads these from the process environment; it never reads a
# .env file itself and never prints their values. Keep real values out of
# version control (.env is git-ignored) and in your host's secret settings.
# The desktop app does not need any of these.

# PostgreSQL connection URL. "postgres://" and "postgresql://" are accepted
# (the psycopg 3 driver is used). Add sslmode=require for remote servers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# HMAC key for access tokens: at least 32 random characters, for example
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional (defaults shown).
# JWT_ISSUER=schedule-maxing
# JWT_AUDIENCE=schedule-maxing-api
# ACCESS_TOKEN_TTL_MINUTES=60
# API_MAX_PAGE_SIZE=500

# Tests only: a DISPOSABLE PostgreSQL database whose name contains "test".
# TEST_DATABASE_URL=postgresql://USER@localhost:5432/schedule_maxing_test
